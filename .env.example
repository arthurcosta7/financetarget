# Copie para .env apenas no ambiente local. Nunca versione credenciais reais.
POSTGRES_DB=financetarget
POSTGRES_USER=financetarget_local
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=55432

DB_URL=jdbc:postgresql://localhost:55432/financetarget
DB_USER=financetarget_local
DB_PASSWORD=change-me-local-only
APP_ENV=dev
APP_DEFAULT_CURRENCY=BRL
APP_BUSINESS_TIME_ZONE=America/Sao_Paulo
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080
APP_AUTH_SECURE_COOKIES=false
APP_TERMS_VERSION=draft-v1-local-only
APP_PRIVACY_NOTICE_VERSION=draft-v1-local-only

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
