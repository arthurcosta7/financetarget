# Modelo sem segredos. Injete valores reais por cofre/runner; não execute este arquivo como está.
POSTGRES_DB=financetarget_staging
POSTGRES_USER=inject-from-secret-store
POSTGRES_PASSWORD=inject-from-secret-store
POSTGRES_PORT=55433

DB_URL=jdbc:postgresql://database.internal:5432/financetarget_staging
DB_USER=inject-from-secret-store
DB_PASSWORD=inject-from-secret-store
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
APP_ENV=staging
APP_BETA_ENABLED=false
APP_DEFAULT_CURRENCY=BRL
APP_BUSINESS_TIME_ZONE=America/Sao_Paulo
APP_CORS_ALLOWED_ORIGINS=https://staging.example.test
SERVER_PORT=8080
APP_AUTH_SECURE_COOKIES=true
APP_TERMS_VERSION=staging-review-v1
APP_PRIVACY_NOTICE_VERSION=staging-review-v1
APP_FEATURE_PAYMENTS_MOCK=false
APP_FEATURE_NOTIFICATIONS_MOCK=false
APP_FEATURE_OPEN_FINANCE=false
APP_FEATURE_LOYALTY=false
APP_FEATURE_TRAVEL=false
APP_FEATURE_REAL_ESTATE_FINANCING=false
APP_FEATURE_AUTO_FINANCING=false
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1

# Chave AES-256 em Base64, injetada somente no job de backup/restauração.
BACKUP_ENCRYPTION_KEY_BASE64=inject-from-secret-store

NEXT_PUBLIC_API_BASE_URL=https://api.staging.example.test
