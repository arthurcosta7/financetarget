{
  "name": "financetarget",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @financetarget/web build",
    "dev:web": "pnpm --filter @financetarget/web dev",
    "generate:api": "pnpm --filter @financetarget/web generate:api",
    "lint": "pnpm --filter @financetarget/web lint",
    "test": "pnpm --filter @financetarget/web test",
    "test:ci": "pnpm --filter @financetarget/web test:ci",
    "typecheck": "pnpm --filter @financetarget/web typecheck"
  }
}
