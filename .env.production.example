# Contrato de configuração, sem valores operacionais. Injete tudo pelo cofre e pela plataforma autorizados.
SPRING_PROFILES_ACTIVE=production
APP_ENV=production
APP_EXPECTED_RELEASE_ID=inject-full-40-character-git-sha

DB_URL=jdbc:postgresql://database.internal:5432/financetarget
DB_USER=inject-from-secret-store
DB_PASSWORD=inject-from-secret-store
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=3000

APP_DEFAULT_CURRENCY=BRL
APP_BUSINESS_TIME_ZONE=America/Sao_Paulo
APP_CORS_ALLOWED_ORIGINS=https://app.example.test
APP_AUTH_SECURE_COOKIES=true
APP_TERMS_VERSION=inject-approved-version
APP_PRIVACY_NOTICE_VERSION=inject-approved-version
APP_BETA_ENABLED=false

APP_FEATURE_PAYMENTS_MOCK=false
APP_FEATURE_NOTIFICATIONS_MOCK=false
APP_FEATURE_OPEN_FINANCE=false
APP_FEATURE_LOYALTY=false
APP_FEATURE_TRAVEL=false
APP_FEATURE_REAL_ESTATE_FINANCING=false
APP_FEATURE_AUTO_FINANCING=false

APP_INTEGRATION_RESEND_ENABLED=true
RESEND_API_KEY=inject-from-secret-store
APP_RESEND_ENDPOINT=https://api.resend.com/emails
APP_EMAIL_FROM_ADDRESS=inject-verified-sender
APP_EMAIL_FROM_NAME=FinanceTarget
APP_PUBLIC_WEB_URL=https://app.example.test
APP_RESEND_CONNECT_TIMEOUT=3s
APP_RESEND_READ_TIMEOUT=8s

MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.05
APP_SHUTDOWN_TIMEOUT=30s

# O frontend de produção usa /api na mesma origem; o gateway encaminha /api/v1 para a API.
NEXT_PUBLIC_API_BASE_URL=

# Exclusiva do job de backup e nunca compartilhada com o processo da aplicação.
BACKUP_ENCRYPTION_KEY_BASE64=inject-from-secret-store
